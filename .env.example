# Second Brain v4 — Environment Template
# Copy to .env and fill. Never commit .env (gitignored). See .env.prod.example for Docker.
# Required: NEON_DSN, LOCAL_DSN, Ollama URLs, PROJECT_* paths

# ── Databases — Dual-Pool ──
# Neon Cloud — memory, conversations, projects, bugs (small, exact search)
NEON_DSN=postgresql://neondb_owner:xxx@ep-xxx-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require
# Local pgvector — chunks_v4, code_graph (9k+, HNSW)
LOCAL_DSN=postgresql://postgres:password@localhost:5432/second_brain
# Alias for Docker (inside compose, host= db)
DATABASE_URL=postgresql://postgres:password@localhost:5432/second_brain

# ── Ollama — Local LLM ──
OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embed
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
OLLAMA_TIMEOUT=300
# Must match `ollama list` on this machine
EMBED_MODEL=nomic-embed-text
EMBED_MODEL_HF=Salesforce/SFR-Embedding-Code-400M_R
EMBED_DIM=768
# Daily driver — 7b is installed (4.7GB, 32K ctx). coder:14b needs `ollama pull qwen2.5-coder:14b`
ARCHITECT_MODEL=qwen2.5:7b
EDITOR_MODEL=qwen2.5:7b
CHAT_MODEL=qwen2.5:7b
MAX_CONSECUTIVE_TOOL_FAILURES=3

# ── Projects — Host paths (used by reindex_v4.py + brain_agent) ──
PROJECT_CONTENT_ENGINE=X:/content engine/Robin-Content-Engine-v2
PROJECT_LVYY=C:/Users/loyal/lvyy-ai-sales-agent
PROJECT_RICO=X:/rico/Rico-Your-AI-intelligent-job-hunt-partner-in-the-UAE
PROJECT_SECOND_BRAIN=X:/unified-llm-local
CURRENT_PROJECT=rico

# ── Optional — Only if you use these ──
GEMINI_API_KEY=
GITHUB_TOKEN=github_pat_xxx
HF_TOKEN=hf_xxx
ALLOWED_ORIGINS=*
DATA_JSON_PATH=./ai-dashboard/data.json
LOG_LEVEL=INFO
AUTO_COMMIT=false
